# Copy this file to .env.local and fill in your keys
# Never commit .env.local to git

# NVIDIA API key from https://build.nvidia.com
# Used by the Vercel function (api/nim-proxy.ts) AND by the local dev
# middleware (vite.config.ts) when running `npm run dev`.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Server-side GitHub token for the bridge relay. Used by api/bridge-relay.ts
# to create/read the pairing mailbox on behalf of tokenless car displays.
# NEVER prefix this with VITE_ — it must stay server-side.
BRIDGE_GITHUB_TOKEN=your_github_token_here

# GitHub Gist token is entered in the app's Settings screen (stored in
# localStorage) and is NEVER bundled into the client build. Do not add a
# VITE_GITHUB_TOKEN here — a VITE_ var would be inlined and exposed to every
# visitor of the deployed app (S-04).

# Set to "true" to make the local dev middleware return a mock NIM response
# (no NVIDIA key needed — the full voice/type → YAML → graph flow works offline).
# Server-side only; it is never sent to NVIDIA or exposed in the client bundle.
# If NVIDIA_API_KEY is missing during `npm run dev`, the mock is used automatically.
VITE_USE_MOCK_NIM=false
