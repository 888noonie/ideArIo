# Copy this file to .env.local and fill in your keys
# Never commit .env.local to git

# NVIDIA API key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional private Gist backup. This token is server-only: never prefix it with VITE_.
# Use a fine-grained token restricted to Gists and enable both flags deliberately.
GITHUB_TOKEN=your_github_token_here
IDEARIO_GIST_SYNC_ENABLED=false
VITE_GIST_SYNC_ENABLED=false

# Optional comma-separated allowlist. When set, it is enforced by the server.
# NVIDIA_ALLOWED_MODELS=deepseek-ai/deepseek-v4-pro,deepseek-ai/deepseek-v4-flash
